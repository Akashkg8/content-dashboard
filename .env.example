# All keys are optional. Without them the app serves realistic mock data
# and shows a "Demo data" badge, so it always runs.

# https://newsapi.org/register (free developer plan, 100 requests/day)
NEWS_API_KEY=

# https://www.themoviedb.org/settings/api (v3 "API Key")
TMDB_API_KEY=

# Force mock data for every source, even when keys are set. Used by E2E tests.
USE_MOCK_DATA=false

# How often the real-time stream pushes a new social post, in milliseconds.
STREAM_INTERVAL_MS=20000
